---
import Base from '@/layouts/Base.astro';
import CodeGate from '@/components/CodeGate.astro';
import Uploader from '@/components/Uploader.svelte';
import { newSession, readSession, writeSession } from '@/lib/server/auth';
import { getEventBySlug } from '@/lib/server/db';

const slug = Astro.params.slug;
if (!slug) {
  return new Response('Evento no encontrado', { status: 404 });
}

const event = await getEventBySlug(slug);
if (!event) {
  return new Response('Evento no encontrado', { status: 404 });
}

let session = await readSession(Astro.cookies);

// Si el evento no tiene código, el link del QR es la llave: sesión automática.
if (!session && !event.code_hash) {
  session = await writeSession(Astro.cookies, newSession(event.id, 'guest'));
}

const allowed = session?.eid === event.id;
const uploadsOpen = Boolean(event.uploads_open);

const date = event.event_date
  ? new Intl.DateTimeFormat('es', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(`${event.event_date}T12:00:00Z`))
  : null;
---

<Base title={`${event.title} · Sube tus fotos`}>
  <main class="wrap hero">
    <div class="stack">
      <p class="kicker">
        {event.couple_names ?? 'Nuestra boda'}{date ? ` · ${date}` : ''}
      </p>
      <h1>Las fotos de esta noche, en un solo lugar.</h1>
      <p class="lede">
        Escanea, elige tus fotos y listo. Sin app y sin crear cuenta: se guardan
        solas en el álbum de los novios.
      </p>
    </div>

    <hr class="hero-rule" />

    {allowed ? (
      <>
        <Uploader
          client:load
          slug={slug}
          uploadsOpen={uploadsOpen}
          galleryHref={`/e/${slug}/galeria`}
        />

        <p class="small muted">
          Las fotos se comprimen en tu teléfono antes de subir para que funcionen
          con poca señal. Se borran los datos de ubicación.
        </p>

        <a class="btn btn-ghost" href={`/e/${slug}/galeria`}>Ver la galería</a>
      </>
    ) : (
      <CodeGate
        endpoint={`/api/e/${slug}/session`}
        hint="El código está en la tarjeta de tu mesa."
        autofocus
      />
    )}
  </main>
</Base>
