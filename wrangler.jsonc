{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fotobag",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "ORIGINALS",
      "bucket_name": "fotobag-originals"
    },
    {
      "binding": "THUMBS",
      "bucket_name": "fotobag-thumbs"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fotobag",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "PUBLIC_THUMBS_BASE": "",
    "PUBLIC_EVENT_SLUG": "mabel-y-belmar",
    "PUBLIC_SITE_URL": ""
  }
}
